#!/bin/bash
#SBATCH -J eval_prefs
#SBATCH -o /home/qx235/unicorn/logs/%x_%j.out
#SBATCH -e /home/qx235/unicorn/logs/%x_%j.err
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --cpus-per-task=4
#SBATCH --get-user-env
#SBATCH --mem=48g
#SBATCH -t 2:00:00
#SBATCH --partition=gpu
#SBATCH --gres=gpu:nvidia_rtx_a6000:2
# Preference eval (sampling + exact answer distribution), TP over all allocated GPUs. Arguments go to
# eval/prefs_eval.py. Results: $OUT_DIR/eval/prefs/<name>/. Usage:
#   slurm/submit_gpu.sh --requeue slurm/eval_prefs.sub --model Qwen/Qwen3-32B --name qwen3_32b
#   slurm/submit_gpu.sh --gres=gpu:nvidia_rtx_a6000:1 slurm/eval_prefs.sub --model <small model> --format base
set -euo pipefail
source /home/qx235/unicorn/env.sh
require_cuda13
export HF_HUB_OFFLINE=1
nvidia-smi -L
python "$PROJECT_DIR/eval/prefs_eval.py" --tp "$(nvidia-smi -L | wc -l)" "$@"
