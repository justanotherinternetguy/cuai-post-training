#!/bin/bash
#SBATCH -J gen
#SBATCH -o /home/qx235/unicorn/logs/%x_%j.out
#SBATCH -e /home/qx235/unicorn/logs/%x_%j.err
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --cpus-per-task=4
#SBATCH --get-user-env
#SBATCH --mem=48g
#SBATCH -t 6:00:00
#SBATCH --partition=gpu
#SBATCH --gres=gpu:nvidia_rtx_a6000:2
# Answer the IFT prompts with one model (gen/generate.py), TP over all allocated GPUs. Usage:
#   slurm/submit_gpu.sh --requeue -J gen_gemma3_27b slurm/gen.sub --model google/gemma-3-27b-it --name gemma3_27b
#   slurm/submit_gpu.sh --gres=gpu:nvidia_rtx_a6000:1 slurm/gen.sub --model <student ckpt> --name <run> \
#       --splits heldout:500 --out-root $OUT_DIR/eval/gen --chat-template configs/student_chat.jinja
set -euo pipefail
source /home/qx235/unicorn/env.sh
require_cuda13
export HF_HUB_OFFLINE=1
cd "$PROJECT_DIR"
nvidia-smi -L
python gen/generate.py --tp "$(nvidia-smi -L | wc -l)" "$@"
