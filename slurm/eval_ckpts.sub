#!/bin/bash
#SBATCH -J eval_ckpts
#SBATCH -o /home/qx235/unicorn/logs/%x_%j.out
#SBATCH -e /home/qx235/unicorn/logs/%x_%j.err
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --cpus-per-task=4
#SBATCH --get-user-env
#SBATCH --mem=48g
#SBATCH -t 4:00:00
#SBATCH --partition=gpu
#SBATCH --gres=gpu:nvidia_rtx_a6000:1
# Evaluate every checkpoint of one finished SFT run (train/eval_ckpts.sh), e.g. when the eval inside
# slurm/train.sub failed or was skipped. Usage:
#   slurm/submit_gpu.sh --requeue slurm/eval_ckpts.sub $OUT_DIR/ckpt/<student>/<run>
set -euo pipefail
source /home/qx235/unicorn/env.sh
require_cuda13
export HF_HUB_OFFLINE=1
cd "$PROJECT_DIR"
nvidia-smi -L
train/eval_ckpts.sh "$1"
