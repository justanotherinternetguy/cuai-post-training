#!/bin/bash
#SBATCH -J cpu
#SBATCH -o /home/qx235/unicorn/logs/%x_%j.out
#SBATCH -e /home/qx235/unicorn/logs/%x_%j.err
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --cpus-per-task=4
#SBATCH --get-user-env
#SBATCH --mem=32g
#SBATCH -t 4:00:00
#SBATCH --partition=default_partition
# CPU job that runs one Python script from the project root. Usage:
#   sbatch -J build_prompts slurm/cpu.sub gen/build_prompts.py [args]
set -euo pipefail
source /home/qx235/unicorn/env.sh
cd "$PROJECT_DIR"
python "$@"
